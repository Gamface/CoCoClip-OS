# Generate each secret with: openssl rand -hex 32  (separate values; keep them stable across restarts)

# ── Paperclip ─────────────────────────────────────────────
BETTER_AUTH_SECRET=
PAPERCLIP_TOOL_ACTION_SIGNING_SECRET=
# Agent API key or board token the backend uses for Paperclip's REST API
PAPERCLIP_API_KEY=

# ── Backend ───────────────────────────────────────────────
# Shared with Paperclip: put it in each HTTP-adapter agent's headers as x-agent-os-secret
AGENT_OS_WEBHOOK_SECRET=
# HMAC key for operator confirmation tokens
CONFIRM_SECRET=
# Optional bearer token protecting the command center + /api (recommended off localhost)
OPERATOR_TOKEN=

# ── Ports on your machine ────────────────────────────────
# Change if something else already uses them. If you change FRONTEND_PORT, set CORS_ORIGIN to match.
FRONTEND_PORT=3000
PAPERCLIP_PORT=3100
CORS_ORIGIN=http://localhost:3000

# ── Paperclip version ────────────────────────────────────
# Upstream commit to build. Empty = the default pinned in docker-compose.yml.
PAPERCLIP_REF=

# ── Data ──────────────────────────────────────────────────
POSTGRES_PASSWORD=

# ── Models / tools ───────────────────────────────────────
ANTHROPIC_API_KEY=
COMPOSIO_API_KEY=
# Default worker model and effort. Override per role in config/org-policy.json ("model", "effort",
# "maxTurns") or per agent from the command center's Workforce panel.
WORKER_MODEL=claude-opus-5-5
WORKER_EFFORT=high
# Operator chat model (AI SDK provider/model). To use OpenAI here, set e.g. openai/<model> and OPENAI_API_KEY.
OPERATOR_MODEL=anthropic/claude-opus-5-5
OPENAI_API_KEY=
# CopilotKit runtime sends anonymous telemetry by default; set true to opt out
COPILOTKIT_TELEMETRY_DISABLED=false
